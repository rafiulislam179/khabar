# --- Server ---
PORT=3000
NODE_ENV=development
# Public URL Twilio calls (your ngrok or Render URL). Needed for signature validation.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# --- Twilio (WhatsApp Sandbox) — OPTIONAL. Leave empty to run the web app only. ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Google Gemini ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# --- MongoDB ---
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/khabar_check

# --- Security ---
# Random secret used to hash phone numbers in memory for per-user rate limits (never stored).
RATE_LIMIT_HASH_SECRET=change_me_to_a_long_random_string
# Comma-separated origins allowed to call non-webhook endpoints (e.g. the future PWA).
CORS_ALLOWED_ORIGINS=http://localhost:5173
